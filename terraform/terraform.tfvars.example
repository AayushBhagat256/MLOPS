aws_region                   = "us-east-1"
app_name                     = "iris-mlops-api"
environment                  = "production"
container_port               = 8000
cpu                          = "1024"  # 1 vCPU
memory                       = "2048"  # 2 GB
auto_scaling_min_size        = 1
auto_scaling_max_size        = 5
auto_scaling_max_concurrency = 100
image_tag                    = "latest"
